{
  "name": "income-expense-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API системи обліку доходів і витрат підприємства (Node.js + Express + PostgreSQL)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test --test-concurrency=1 tests/unit/validators.test.js tests/integration/repositories.test.js tests/api.test.js",
    "test:unit": "node --test tests/unit/validators.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/repositories.test.js",
    "test:api": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
